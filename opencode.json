{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },
  "small_model": "ollama/qwen2.5-coder:3b",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "__pycache__/**",
      "*.pyc",
      ".next/**",
      "build/**",
      "coverage/**",
      ".cache/**",
      ".venv/**",
      "venv/**"
    ]
  },
  "snapshot": false
}
